<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:background="@color/white"
    tools:context=".English"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_root"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/surface">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                app:itemIconTint="@color/nav_item_pill_color"
                app:itemTextColor="@color/nav_item_pill_color"
                app:labelVisibilityMode="selected"
                app:itemHorizontalTranslationEnabled="false"
                app:itemActiveIndicatorStyle="@style/App.BottomNav.ActiveIndicator"
                app:menu="@menu/history_nav_menu" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>


</androidx.drawerlayout.widget.DrawerLayout>
