<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- APP BAR -->
            <include
                layout="@layout/appbar" />

            <!-- FRAGMENT CONTAINER -->
            <FrameLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- FLOATING BOTTOM NAVIGATION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_sm"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_lg"
                app:cardBackgroundColor="@color/surface">

                <com.google.android.material.bottomnavigation.BottomNavigationView
                    android:id="@+id/bottom_nav"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@android:color/transparent"
                    app:itemIconTint="@color/nav_item_pill_color"
                    app:itemTextColor="@color/nav_item_pill_color"
                    app:labelVisibilityMode="selected"
                    app:itemHorizontalTranslationEnabled="false"
                    app:itemActiveIndicatorStyle="@style/App.BottomNav.ActiveIndicator"
                    app:menu="@menu/bottom_nav_menu" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- DELETE ZONE OVERLAY (Hidden by default) -->
        <FrameLayout
            android:id="@+id/deleteZoneOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone">

            <!-- Delete Zone Circle -->
            <LinearLayout
                android:id="@+id/deleteZone"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="100dp"
                android:gravity="center"
                android:background="@drawable/delete_zone_bg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textSize="32sp"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- AI CHAT FAB (Draggable) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_ai_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/space_md"
            android:layout_marginBottom="100dp"
            android:src="@drawable/ai"
            android:contentDescription="AI Chat"
            app:backgroundTint="@color/primary"
            app:tint="@color/white"
            app:fabSize="normal"
            app:elevation="@dimen/elevation_md" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- DRAWER MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
