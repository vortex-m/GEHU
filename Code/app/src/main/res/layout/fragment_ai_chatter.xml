<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/surface">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- BACKGROUND INSTRUCTIONS (Disappear when user types)        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/instructionsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/messageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- AI Robot Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/aiAnimation"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:lottie_rawRes="@raw/airobot"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Hi! I'm your AI Tutor"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/audi"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Ask me anything about your subjects!"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/audi"
            android:gravity="center" />

        <!-- Instruction Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_xl">

            <!-- Tip 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md"
                android:background="@drawable/instruction_card_bg"
                android:layout_marginBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="Ask about any chapter or concept"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/audi" />
            </LinearLayout>

            <!-- Tip 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md"
                android:background="@drawable/instruction_card_bg"
                android:layout_marginBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="I know Math, Science, English &amp; SST"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/audi" />
            </LinearLayout>

            <!-- Tip 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_md"
                android:background="@drawable/instruction_card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="Works offline - No internet needed!"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/audi" />
            </LinearLayout>
        </LinearLayout>

        <!-- Example Question -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Try: 'What is photosynthesis?'"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"
            android:fontFamily="@font/audi"
            android:fontStyle="italic" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CHAT MESSAGES (Hidden initially, shown when chatting)       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/space_md"
        android:paddingTop="40dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/messageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- LOADING INDICATOR                                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/messageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- MESSAGE INPUT BAR                                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/messageBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_sm"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="@dimen/elevation_sm"
        app:cardBackgroundColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_sm">

            <ImageButton
                android:id="@+id/keyboardToggle"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add" 
                android:padding="@dimen/space_sm"
                app:tint="@color/primary"
                android:contentDescription="Keyboard" />

             <EditText
                android:id="@+id/inputMessage"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:hint="Ask me anything..."
                android:background="@null"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:fontFamily="@font/audi"
                android:inputType="textMultiLine"
                android:maxLines="4" />

            <ImageButton
                android:id="@+id/sendBtn"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/circle_primary"
                android:src="@drawable/send"
                android:padding="@dimen/space_sm"
                app:tint="@color/white"
                android:contentDescription="Send" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/customKeyboard"
        layout="@layout/view_custom_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
