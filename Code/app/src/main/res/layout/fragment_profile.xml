<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Profile Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_lg">

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/avatar_lg"
                android:layout_height="@dimen/avatar_lg"
                app:cardCornerRadius="48dp"
                app:cardElevation="@dimen/elevation_md"
                app:cardBackgroundColor="@color/surface">

                <ImageView
                    android:id="@+id/ivProfilePic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/user"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="Student Name"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/audi" />

            <TextView
                android:id="@+id/tvClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="Class 10-A"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/audi" />
        </LinearLayout>

        <!-- Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/elevation_sm"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📧 student@gmail.com"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/audi" />

                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="📱 +91 XXXXXXXXXX"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/audi" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="📍 Chandigarh"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/audi" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Edit Profile"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/audi"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Log Out"
            android:textSize="@dimen/text_body"
            android:textColor="@color/error"
            android:fontFamily="@font/audi"
            android:backgroundTint="@color/surface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_xxl" />

    </LinearLayout>
</ScrollView>
