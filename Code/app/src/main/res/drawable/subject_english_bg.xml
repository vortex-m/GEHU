<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Beautiful purple gradient for English -->
    <gradient
        android:angle="135"
        android:startColor="#9B59B6"
        android:centerColor="#8E44AD"
        android:endColor="#7D3C98"
        android:type="linear" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Subtle shadow effect with stroke -->
    <stroke
        android:width="1dp"
        android:color="#6C3483" />

    <!-- Inner spacing -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
