<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item
        android:left="0dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_light"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    
    <!-- Bubble with gradient -->
    <item
        android:bottom="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/ai_bubble_start"
                android:endColor="@color/ai_bubble_end"
                android:type="linear"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</layer-list>
