<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Beautiful blue gradient for Mathematics -->
    <gradient
        android:angle="135"
        android:startColor="#4A90E2"
        android:centerColor="#5B9BD5"
        android:endColor="#357ABD"
        android:type="linear" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Subtle shadow effect with stroke -->
    <stroke
        android:width="1dp"
        android:color="#2D5F8D" />

    <!-- Inner spacing -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
