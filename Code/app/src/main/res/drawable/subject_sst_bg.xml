<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Beautiful orange gradient for Social Science -->
    <gradient
        android:angle="135"
        android:startColor="#F39C12"
        android:centerColor="#E88B10"
        android:endColor="#E67E22"
        android:type="linear" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Subtle shadow effect with stroke -->
    <stroke
        android:width="1dp"
        android:color="#CA6F1E" />

    <!-- Inner spacing -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
