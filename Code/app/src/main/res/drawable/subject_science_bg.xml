<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Beautiful green gradient for Science -->
    <gradient
        android:angle="135"
        android:startColor="#50C878"
        android:centerColor="#3CB371"
        android:endColor="#2E8B57"
        android:type="linear" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Subtle shadow effect with stroke -->
    <stroke
        android:width="1dp"
        android:color="#267347" />

    <!-- Inner spacing -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
